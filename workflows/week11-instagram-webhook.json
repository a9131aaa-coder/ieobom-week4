              "name": "image_url",
              "value": "={{ $json.body.image_url }}",
              "type": "string"
            },
            {
              "id": "f37292b1-6a4c-4b71-8ce0-000000000123",
              "name": "caption",
              "value": "={{ $json.body.caption }}",
