# 실제 값은 .env.local 또는 Vercel 환경변수에만 넣습니다.
# 비밀 키가 들어간 파일을 GitHub나 대화에 올리지 마세요.

# 로그인 및 사용자별 RLS 요청: 공개 URL과 publishable 키
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 서버 전용: 기존 공통 예시 자료 및 RAG 검색/인덱싱용
SUPABASE_SECRET_KEY=

# 서버 전용 Gemini 키
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
CHAT_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-2

# 서버 전용 Instagram 게시 연결
INSTAGRAM_OWNER_USER_ID=
N8N_INSTAGRAM_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
DEFAULT_INSTAGRAM_IMAGE_URL=
